# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are for LOCAL tooling only (deploy scripts, verify.sh).
# Runtime credentials for external APIs live in Snowflake SECRET objects — see
# snowflake/00_setup/04_external_access.sql — not here.

# Account identifier, NOT the full URL. Derive it from your Snowflake console
# hostname by dropping the ".snowflakecomputing.com" suffix:
#   https://<org>-<account>.snowflakecomputing.com  ->  SNOWFLAKE_ACCOUNT=<ORG>-<ACCOUNT>
# This repository is PUBLIC, so the real value belongs only in your local .env.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=IHA_ENGINEER
SNOWFLAKE_WAREHOUSE=IHA_WH_XS
SNOWFLAKE_DATABASE=IRVINE_HOME_ANALYSIS

# Prefer key-pair auth over password. Path to your private key:
SNOWFLAKE_PRIVATE_KEY_PATH=

# Contact address embedded in crawler User-Agent strings so site owners can reach you.
# Required by ingest/adapters/* — crawling without a reachable contact is not acceptable.
CRAWLER_CONTACT_EMAIL=

# Optional third-party API keys (Phase 2 sentiment tiers).
# Leave blank to keep those adapters disabled.
YOUTUBE_API_KEY=
GOOGLE_PLACES_API_KEY=
CENSUS_API_KEY=
