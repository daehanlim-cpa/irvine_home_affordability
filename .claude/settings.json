{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_bash.sh\"",
            "timeout": 20,
            "statusMessage": "Checking hard constraints"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_write.sh\"",
            "timeout": 20,
            "statusMessage": "Scanning for credentials"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/post_edit.sh\"",
            "timeout": 60,
            "statusMessage": "Linting and checking crawl policy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/session_start.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(sqlfluff lint:*)",
      "Bash(python3 -m pytest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./*.pem)",
      "Read(./*.p8)"
    ]
  }
}
